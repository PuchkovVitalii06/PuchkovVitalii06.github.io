# Настройка веб-сервера для Railway.
# На GitHub Pages сервер был не нужен — там файлы раздаёт сам GitHub.
# Railway запускает контейнер, поэтому раздачей занимается Caddy.

# Railway сам говорит контейнеру, какой порт слушать, через переменную PORT.
# Если её нет (например, при запуске у себя на компьютере) — берём 80.
:{$PORT:80} {
	root * /srv
	file_server

	# Сжатие: страница и стили уезжают к посетителю меньшим объёмом
	encode gzip zstd

	# Картинки не меняются — разрешаем браузеру держать их в кэше,
	# чтобы при повторном заходе он их не перекачивал
	@images path /images/*
	header @images Cache-Control "public, max-age=604800"
}
