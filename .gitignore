# Локальные настройки редактора — у каждого свои, в общий репозиторий не нужны
.claude/settings.local.json

# Ставится через npm install/ci — каждый раз заново, в репозиторий не кладём
node_modules

# Служебные файлы ОС
Thumbs.db
desktop.ini
.DS_Store

# Файл базы данных — в репозиторий не кладём никогда
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Выгрузки и резервные копии базы
*.sql
*.dump
*.bak

# Заявки клиентов: ФИО и телефоны. Им в репозитории не место
*.csv
*.xls
*.xlsx
/data/
/backups/

# Выгрузки базы данных с сервера — боевые данные, в репозиторий не кладём
/backup/

# Ключи, токены, пароли
.env
.env.*
secrets.*
config.local.*
*.pem
*.key
*.p12
*.pfx

# Скриншоты и мусор от проверки лендинга
screen-*.png
.playwright-mcp/
